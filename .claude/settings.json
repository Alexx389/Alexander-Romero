{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(codex:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Edit(.claude/settings.json)",
      "Read(./.env)"
    ]
  }
}
